  </main>



  <script>


    /*
    ========================================================
    BUSCA / FILTROS
    ========================================================
    */


    const search =
      document.getElementById(
        'search'
      );


    const rows =
      Array.from(
        document.querySelectorAll(
          '[data-row]'
        )
      );


    const filters =
      Array.from(
        document.querySelectorAll(
          '[data-filter]'
        )
      );


    let activeFilter =
      'all';



    function normalizeText(
      value
    ) {


      return (
        value
          .toLowerCase()
          .normalize(
            'NFD'
          )
          .replace(
            /[\u0300-\u036f]/g,
            ''
          )
      );


    }



    function update() {


      const term =
        normalizeText(
          (
            search?.value
            ??
            ''
          )
          .trim()
        );


      rows.forEach(
        row => {


          const text =
            normalizeText(
              row.dataset.search
              ??
              ''
            );


          const categories =
            normalizeText(
              row.dataset.category
              ??
              ''
            );


          const normalizedFilter =
            normalizeText(
              activeFilter
            );


          const matchesSearch =
            !term
            ||
            text.includes(
              term
            );


          const matchesFilter =
            activeFilter
            ===
            'all'
            ||
            categories.includes(
              normalizedFilter
            );


          row.style.display =
            matchesSearch
            &&
            matchesFilter

            ?
            'grid'

            :
            'none';


        }
      );


    }



    search
      ?.addEventListener(
        'input',
        update
      );



    filters.forEach(
      button => {


        button.addEventListener(
          'click',

          () => {


            activeFilter =
              button.dataset.filter
              ??
              'all';


            filters.forEach(
              item => {

                item.classList.remove(
                  'active'
                );

              }
            );


            button.classList.add(
              'active'
            );


            update();


          }
        );


      }
    );


  </script>


