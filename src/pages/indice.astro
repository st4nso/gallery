---
import { projects } from '../data/projects';


const indexProjects =
  projects.filter(
    project =>
      project.slug !== 'scroll'
  );
---

<!doctype html>

<html lang="pt-BR">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="
      width=device-width,
      initial-scale=1,
      viewport-fit=cover
    "
  />

  <meta
    name="description"
    content="Índice de projetos de Lucas Stanso."
  />

  <title>
    STANSO — ÍNDICE
  </title>


  <style>

    /*
    ========================================================
    GLOBAL
    ========================================================
    */


    :root {

      --bg:
        #f2f2ee;

      --ink:
        #11110f;

      --muted:
        #85857f;

      --line:
        rgba(
          17,
          17,
          15,
          .17
        );


      font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        Helvetica,
        sans-serif;

    }


    * {

      box-sizing:
        border-box;

    }


    html {

      margin:
        0;

      padding:
        0;

      width:
        100%;

      scroll-behavior:
        smooth;

      background:
        var(--bg);

      -webkit-text-size-adjust:
        100%;

      text-size-adjust:
        100%;

    }


    body {

      margin:
        0;

      width:
        100%;

      min-width:
        0;

      overflow-x:
        clip;

      color:
        var(--ink);

      background:
        var(--bg);

    }


    a {

      color:
        inherit;

      text-decoration:
        none;

    }


    button,
    input {

      font:
        inherit;

    }



    /*
    ========================================================
    HEADER
    ========================================================
    */


    .header {

      position:
        sticky;

      top:
        0;

      z-index:
        100;

      height:
        64px;

      padding:
        0
        24px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      background:
        rgba(
          242,
          242,
          238,
          .92
        );

      backdrop-filter:
        blur(
          10px
        );

      -webkit-backdrop-filter:
        blur(
          10px
        );

      border-bottom:
        1px
        solid
        rgba(
          17,
          17,
          15,
          .08
        );

    }


    .brand {

      min-height:
        44px;

      display:
        inline-flex;

      align-items:
        center;

      font-size:
        12px;

      font-weight:
        630;

    }


    nav {

      display:
        flex;

      align-items:
        center;

      gap:
        28px;

    }


    nav a {

      min-height:
        44px;

      display:
        inline-flex;

      align-items:
        center;

      color:
        #777771;

      font-size:
        12px;

      -webkit-tap-highlight-color:
        transparent;

    }


    nav a:hover,
    nav .active {

      color:
        var(--ink);

    }


    nav .active {

      position:
        relative;

    }


    nav .active::after {

      content:
        '';

      position:
        absolute;

      left:
        0;

      right:
        0;

      bottom:
        7px;

      height:
        1px;

      background:
        var(--ink);

    }



    /*
    ========================================================
    MAIN
    ========================================================
    */


    main {

      width:
        100%;

      padding:
        65px
        24px
        120px;

    }



    /*
    ========================================================
    TOPO
    ========================================================
    */


    .top {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        35px;

      margin-bottom:
        90px;

    }


    h1 {

      margin:
        0;

      font-size:
        clamp(
          72px,
          10vw,
          165px
        );

      line-height:
        .78;

      font-weight:
        610;

      letter-spacing:
        -.07em;

    }


    .intro {

      align-self:
        end;

      max-width:
        450px;

      font-size:
        13px;

      line-height:
        1.45;

    }



    /*
    ========================================================
    BUSCA + FILTROS
    ========================================================
    */


    .tools {

      display:
        grid;

      grid-template-columns:
        minmax(
          240px,
          1fr
        )
        2fr;

      gap:
        30px;

      margin-bottom:
        30px;

    }


    input {

      width:
        100%;

      min-width:
        0;

      padding:
        11px
        0;

      border:
        0;

      border-bottom:
        1px
        solid
        var(--line);

      border-radius:
        0;

      outline:
        none;

      background:
        transparent;

      color:
        var(--ink);

      font-size:
        12px;

      appearance:
        none;

      -webkit-appearance:
        none;

    }


    input::placeholder {

      color:
        var(--muted);

    }


    input:focus {

      border-bottom-color:
        var(--ink);

    }


    input::-webkit-search-cancel-button {

      cursor:
        pointer;

    }


    .filters {

      display:
        flex;

      align-items:
        center;

      flex-wrap:
        wrap;

      gap:
        8px;

    }


    .filter {

      appearance:
        none;

      -webkit-appearance:
        none;

      min-height:
        34px;

      border:
        1px
        solid
        var(--line);

      background:
        transparent;

      padding:
        7px
        10px;

      border-radius:
        999px;

      cursor:
        pointer;

      color:
        #72726c;

      font-size:
        9px;

      white-space:
        nowrap;

      -webkit-tap-highlight-color:
        transparent;

    }


    .filter.active {

      background:
        var(--ink);

      color:
        var(--bg);

    }


    .filter:focus-visible {

      outline:
        1px
        solid
        var(--ink);

      outline-offset:
        2px;

    }



    /*
    ========================================================
    ÍNDICE
    ========================================================
    */


    .table {

      border-top:
        1px
        solid
        var(--line);

    }


    .row {

      min-width:
        0;

      display:
        grid;

      grid-template-columns:
        90px
        minmax(
          220px,
          1.3fr
        )
        minmax(
          0,
          1fr
        )
        minmax(
          0,
          1fr
        );

      gap:
        20px;

      padding:
        15px
        0;

      border-bottom:
        1px
        solid
        var(--line);

      transition:
        padding
        .2s
        ease,
        opacity
        .15s
        ease;

      -webkit-tap-highlight-color:
        transparent;

    }


    @media (
      hover: hover
    )
    and (
      pointer: fine
    ) {

      .row:hover {

        padding-left:
          8px;

      }

    }


    .year {

      color:
        var(--muted);

      font-size:
        10px;

      line-height:
        1.35;

    }


    .title {

      min-width:
        0;

      font-size:
        14px;

      font-weight:
        580;

      line-height:
        1.2;

      letter-spacing:
        -.02em;

      overflow-wrap:
        anywhere;

    }


    .roles,
    .type {

      min-width:
        0;

      color:
        #70706a;

      font-size:
        10px;

      line-height:
        1.35;

      overflow-wrap:
        anywhere;

    }



    /*
    ========================================================
    SOBRE / CONTATO
    ========================================================
    */


    .about {

      scroll-margin-top:
        90px;

      margin-top:
        150px;

      padding-top:
        25px;

      border-top:
        1px
        solid
        var(--line);

    }


    .about-grid {

      display:
        grid;

      grid-template-columns:
        90px
        minmax(
          280px,
          1.3fr
        )
        minmax(
          0,
          1fr
        )
        minmax(
          0,
          1fr
        );

      gap:
        20px;

    }


    .about-label,
    .contact-label {

      color:
        var(--muted);

      font-size:
        9px;

      text-transform:
        uppercase;

    }


    .about-text {

      max-width:
        560px;

      margin:
        0;

      font-size:
        15px;

      line-height:
        1.5;

      letter-spacing:
        -.015em;

    }


    .contact {

      grid-column:
        3 / 5;

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        20px;

    }


    .contact-item {

      min-width:
        0;

      display:
        flex;

      flex-direction:
        column;

      gap:
        7px;

    }


    .contact-link {

      width:
        fit-content;

      max-width:
        100%;

      min-height:
        34px;

      display:
        inline-flex;

      align-items:
        flex-start;

      font-size:
        13px;

      line-height:
        1.3;

      border-bottom:
        1px
        solid
        transparent;

      overflow-wrap:
        anywhere;

      -webkit-tap-highlight-color:
        transparent;

    }


    @media (
      hover: hover
    )
    and (
      pointer: fine
    ) {

      .contact-link:hover {

        border-bottom-color:
          var(--ink);

      }

    }


    .about-footer {

      margin-top:
        100px;

      padding-top:
        15px;

      border-top:
        1px
        solid
        var(--line);

      display:
        flex;

      justify-content:
        space-between;

      gap:
        20px;

      color:
        var(--muted);

      font-size:
        9px;

    }



    /*
    ========================================================
    TABLET / MOBILE
    ========================================================
    */


    @media (
      max-width:
      900px
    ) {


      html {

        overflow-x:
          hidden;

      }


      body {

        overflow-x:
          hidden;

      }


      .header {

        height:
          56px;

        padding-left:
          max(
            14px,
            env(
              safe-area-inset-left
            )
          );

        padding-right:
          max(
            14px,
            env(
              safe-area-inset-right
            )
          );

      }


      .brand {

        min-height:
          44px;

        font-size:
          10px;

      }


      nav {

        gap:
          clamp(
            8px,
            3vw,
            14px
          );

      }


      nav a {

        min-height:
          44px;

        font-size:
          9px;

      }


      nav .active::after {

        bottom:
          5px;

      }


      main {

        padding-top:
          clamp(
            40px,
            10vw,
            56px
          );

        padding-right:
          14px;

        padding-bottom:
          max(
            86px,
            env(
              safe-area-inset-bottom
            )
          );

        padding-left:
          14px;

      }



      /*
      TOPO
      */


      .top {

        grid-template-columns:
          1fr;

        gap:
          28px;

        margin-bottom:
          clamp(
            58px,
            17vw,
            76px
          );

      }


      h1 {

        max-width:
          100%;

        font-size:
          clamp(
            62px,
            19vw,
            112px
          );

        line-height:
          .8;

      }


      .intro {

        max-width:
          360px;

        font-size:
          12px;

        line-height:
          1.5;

      }



      /*
      BUSCA
      */


      .tools {

        grid-template-columns:
          1fr;

        gap:
          18px;

        margin-bottom:
          24px;

      }


      input {

        min-height:
          46px;

        padding:
          12px
          0;

        /*
        16px impede o zoom automático
        do Safari ao focar o campo.
        */

        font-size:
          16px;

      }



      /*
      FILTROS
      */


      .filters {

        width:
          calc(
            100% + 28px
          );

        margin-left:
          -14px;

        padding:
          0
          14px
          6px;

        flex-wrap:
          nowrap;

        gap:
          7px;

        overflow-x:
          auto;

        overflow-y:
          hidden;

        overscroll-behavior-x:
          contain;

        scroll-padding-inline:
          14px;

        scrollbar-width:
          none;

        -webkit-overflow-scrolling:
          touch;

      }


      .filters::-webkit-scrollbar {

        display:
          none;

      }


      .filter {

        flex:
          0
          0
          auto;

        min-height:
          40px;

        padding:
          8px
          12px;

        font-size:
          9px;

      }



      /*
      LINHAS
      */


      .row {

        grid-template-columns:
          52px
          minmax(
            0,
            1fr
          );

        column-gap:
          14px;

        row-gap:
          7px;

        min-height:
          84px;

        padding:
          18px
          0
          19px;

      }


      .row:active {

        opacity:
          .58;

      }


      .year {

        grid-column:
          1;

        grid-row:
          1;

        padding-top:
          2px;

        font-size:
          9px;

      }


      .title {

        grid-column:
          2;

        grid-row:
          1;

        min-width:
          0;

        padding-right:
          4px;

        font-size:
          13px;

        line-height:
          1.18;

      }


      .roles,
      .type {

        grid-column:
          2;

        min-width:
          0;

        font-size:
          9px;

        line-height:
          1.45;

      }


      .roles {

        grid-row:
          2;

      }


      .type {

        grid-row:
          3;

        color:
          var(--muted);

      }



      /*
      SOBRE
      */


      .about {

        scroll-margin-top:
          72px;

        margin-top:
          clamp(
            92px,
            25vw,
            118px
          );

        padding-top:
          20px;

      }


      .about-grid {

        grid-template-columns:
          52px
          minmax(
            0,
            1fr
          );

        column-gap:
          14px;

        row-gap:
          34px;

      }


      .about-label {

        grid-column:
          1;

        grid-row:
          1;

      }


      .about-text {

        grid-column:
          2;

        grid-row:
          1;

        max-width:
          100%;

        font-size:
          14px;

        line-height:
          1.52;

      }


      .contact {

        grid-column:
          2;

        grid-row:
          2;

        grid-template-columns:
          repeat(
            2,
            minmax(
              0,
              1fr
            )
          );

        gap:
          18px;

      }


      .contact-link {

        min-height:
          44px;

        font-size:
          12px;

      }


      .about-footer {

        margin-top:
          72px;

        padding-top:
          12px;

      }

    }



    /*
    ========================================================
    MOBILE MÉDIO
    ========================================================
    */


    @media (
      max-width:
      600px
    ) {


      .top {

        margin-bottom:
          60px;

      }


      h1 {

        font-size:
          clamp(
            66px,
            21vw,
            100px
          );

      }


      .row {

        grid-template-columns:
          46px
          minmax(
            0,
            1fr
          );

        column-gap:
          12px;

      }


      .about-grid {

        grid-template-columns:
          46px
          minmax(
            0,
            1fr
          );

        column-gap:
          12px;

      }


      .contact {

        grid-template-columns:
          1fr
          1fr;

      }

    }



    /*
    ========================================================
    MOBILE PEQUENO
    ========================================================
    */


    @media (
      max-width:
      390px
    ) {


      .header {

        height:
          54px;

        padding-left:
          max(
            12px,
            env(
              safe-area-inset-left
            )
          );

        padding-right:
          max(
            12px,
            env(
              safe-area-inset-right
            )
          );

      }


      .brand {

        font-size:
          9px;

      }


      nav {

        gap:
          6px;

      }


      nav a {

        padding:
          0
          2px;

        font-size:
          8px;

      }


      main {

        padding-left:
          12px;

        padding-right:
          12px;

      }


      h1 {

        font-size:
          clamp(
            62px,
            21vw,
            86px
          );

      }


      .filters {

        width:
          calc(
            100% + 24px
          );

        margin-left:
          -12px;

        padding-left:
          12px;

        padding-right:
          12px;

        scroll-padding-inline:
          12px;

      }


      .filter {

        min-height:
          38px;

        padding:
          7px
          11px;

        font-size:
          8.5px;

      }


      .row {

        grid-template-columns:
          42px
          minmax(
            0,
            1fr
          );

        column-gap:
          10px;

        min-height:
          80px;

        padding-top:
          17px;

        padding-bottom:
          18px;

      }


      .year {

        font-size:
          8px;

      }


      .title {

        font-size:
          12.5px;

      }


      .roles,
      .type {

        font-size:
          8.5px;

      }


      .about-grid {

        grid-template-columns:
          42px
          minmax(
            0,
            1fr
          );

        column-gap:
          10px;

      }


      .about-text {

        font-size:
          13.5px;

      }


      .contact {

        grid-template-columns:
          1fr;

        gap:
          22px;

      }


      .contact-link {

        min-height:
          40px;

      }


      .about-footer {

        gap:
          14px;

        font-size:
          8px;

      }

    }



    /*
    ========================================================
    MOBILE MUITO PEQUENO
    ========================================================
    */


    @media (
      max-width:
      340px
    ) {


      .brand {

        font-size:
          8.5px;

      }


      nav {

        gap:
          3px;

      }


      nav a {

        font-size:
          7.5px;

      }


      h1 {

        font-size:
          20vw;

      }


      .row {

        grid-template-columns:
          38px
          minmax(
            0,
            1fr
          );

        column-gap:
          8px;

      }


      .about-grid {

        grid-template-columns:
          38px
          minmax(
            0,
            1fr
          );

        column-gap:
          8px;

      }


      .about-footer {

        flex-direction:
          column;

        align-items:
          flex-start;

        gap:
          7px;

      }

    }



    /*
    ========================================================
    REDUCED MOTION
    ========================================================
    */


    @media (
      prefers-reduced-motion:
      reduce
    ) {


      html {

        scroll-behavior:
          auto;

      }


      .row {

        transition:
          none;

      }

    }

  </style>

</head>


<body>


  <!--
  ========================================================
  HEADER
  ========================================================
  -->


  <header
    class="header"
  >


    <a
      href="/campo"

      class="brand"
    >
      STANSO
    </a>


    <nav
      aria-label="
        Navegação principal
      "
    >


      <a
        href="/campo"
      >
        CAMPO
      </a>


      <a
        href="/indice"

        class="active"

        aria-current="page"
      >
        ÍNDICE
      </a>


      <a
        href="/indice#sobre"
      >
        CONTATO
      </a>


    </nav>


  </header>



  <main>


    <!--
    ========================================================
    TOPO
    ========================================================
    -->


    <section
      class="top"
    >


      <h1>
        ÍNDICE
      </h1>


      <div
        class="intro"
      >

        Projetos, editoriais, colaborações, fotografia,
        direção de arte, styling e arquivo.

      </div>


    </section>



    <!--
    ========================================================
    FERRAMENTAS
    ========================================================
    -->


    <section
      class="tools"
    >


      <input
        type="search"

        id="search"

        placeholder="
          buscar projeto
        "

        aria-label="
          Buscar projeto
        "

        autocomplete="off"

        autocapitalize="off"

        spellcheck="false"
      />


      <div
        class="filters"

        aria-label="
          Filtrar projetos por área
        "
      >


        <button
          class="
            filter
            active
          "

          type="button"

          data-filter="all"
        >
          TODOS
        </button>


        <button
          class="filter"

          type="button"

          data-filter="fotografia"
        >
          FOTOGRAFIA
        </button>


        <button
          class="filter"

          type="button"

          data-filter="direção de arte"
        >
          DIREÇÃO DE ARTE
        </button>


        <button
          class="filter"

          type="button"

          data-filter="styling"
        >
          STYLING
        </button>


        <button
          class="filter"

          type="button"

          data-filter="edição"
        >
          EDIÇÃO
        </button>


        <button
          class="filter"

          type="button"

          data-filter="design editorial"
        >
          DESIGN EDITORIAL
        </button>


      </div>


    </section>



    <!--
    ========================================================
    PROJETOS
    ========================================================
    -->


    <section
      class="table"
    >


      <a
        class="row"

        href="/projetos/scroll"

        data-row

        data-search="
          scroll pesquisa fotografia styling edição
          direção de arte design editorial publicação tcc
        "

        data-category="
          fotografia direção de arte styling
          edição design editorial
        "
      >


        <span
          class="year"
        >
          2025—2026
        </span>


        <span
          class="title"
        >
          SCROLL
        </span>


        <span
          class="roles"
        >
          pesquisa / fotografia / direção de arte /
          styling / design editorial
        </span>


        <span
          class="type"
        >
          TCC / publicação
        </span>


      </a>



      {
        indexProjects.map(
          project => (

            <a
              class="row"

              href={
                `/projetos/${project.slug}`
