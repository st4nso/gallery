import { projects } from '../../data/projects';
import { scrollContent } from '../../data/scroll';


export function getStaticPaths() {

  return projects.map(
    (project) => ({

      params: {
        slug: project.slug
      },

      props: {
        project
      }

    })
  );

}


const { project } = Astro.props;


const isScroll =
  project.slug === 'scroll';


const isScrollEditorial =
  !isScroll &&
  project.relation === 'scroll';


const currentIndex =
  projects.findIndex(
    (item) =>
      item.slug === project.slug
  );


const nextProject =
  projects[
    (currentIndex + 1) %
    projects.length
  ];


const findProject =
  (slug: string) =>
    projects.find(
      (item) =>
        item.slug === slug
    );


/*
=========================================================
EDITORIAIS DE SCROLL
=========================================================
*/


const scrollEditorialOrder = [
  'nomofobia',
  'plt',
  'feed',
  'irl'
];


const currentEditorialIndex =
  scrollEditorialOrder.indexOf(
    project.slug
  );


const nextEditorialSlug =
  currentEditorialIndex >= 0
    ? scrollEditorialOrder[
        (
          currentEditorialIndex + 1
        )
        %
        scrollEditorialOrder.length
      ]
    : undefined;


const editorialNext =
  nextEditorialSlug
    ? findProject(
        nextEditorialSlug
      )
    : undefined;


const scrollEditorials =
  scrollContent
    .editorials
    .items
    .map(
      (item) => ({

        ...item,

        project:
          findProject(
            item.slug
          )

      })
    );


/*
=========================================================
GALERIA
=========================================================
*/


const defaultEditorialLayout = [
  'full',
  'medium-left',
  'medium-right',
  'wide',
  'small-right',
  'pair-left',
  'pair-right',
  'full'
];


const getGalleryLayout =
  (index: number) => {

    if (
      project.galleryLayout &&
      project.galleryLayout[index]
    ) {

      return (
        project.galleryLayout[index]
      );

    }


    return (
      defaultEditorialLayout[
        index %
        defaultEditorialLayout.length
      ]
    );

  };


const editorialIntro =
  project.editorialIntro ||
  project.description;


/*
=========================================================
TÍTULO
=========================================================
*/


const titleLength =
  project.title
    .replace(
      /\s+/g,
      ''
    )
    .length;


const titleSizeClass =
  titleLength <= 5
    ? 'title-short'
    : titleLength <= 9
      ? 'title-medium'
      : titleLength <= 12
        ? 'title-long'
        : 'title-xlong';


/*
=========================================================
HERO DE PROJETOS NORMAIS
=========================================================
*/


const normalHero =
  project.randomHero
  &&
  project.gallery?.length

    ? project.gallery[0]

    : project.hero;


const randomGalleryData =
  project.randomHero

    ? JSON.stringify(
        project.gallery
      )

    : '';
