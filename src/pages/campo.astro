---
import { projects } from '../data/projects';

const STAGE_WIDTH = 2900;
const STAGE_HEIGHT = 2000;

const projectOrder = [
  'scroll',
  'nomofobia',
  'plt',
  'feed',
  'irl',
  'memorias-de-marte',
  'sem-doc',
  'nunca-mais-do-mesmo',
  'im-so-proud-of-u',
  'sentinel',
  'dj-smoke',
  'radio-club',
  'arquivo-pb',
  'crystalline',
  'palato'
];

const orderIndex = new Map(
  projectOrder.map((slug, index) => [slug, index])
);

const orderedProjects = [...projects].sort((a, b) => {
  const aIndex = orderIndex.get(a.slug) ?? 999;
  const bIndex = orderIndex.get(b.slug) ?? 999;
  return aIndex - bIndex;
});

const fieldOverrides: Record<
  string,
  {
    x: number;
    y: number;
    width: number;
    imageHeight?: number;
    fit?: 'cover' | 'contain';
    objectPosition?: string;
    opacity?: number;
    z?: number;
  }
> = {
  scroll: {
    x: 825,
    y: 650,
    width: 610,
    imageHeight: 170,
    opacity: 1,
    z: 10
  },
  nomofobia: {
    x: 140,
    y: 160,
    width: 455,
    imageHeight: 540,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 9
  },
  plt: {
    x: 760,
    y: 1110,
    width: 255,
    imageHeight: 335,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 8
  },
  feed: {
    x: 1660,
    y: 730,
    width: 260,
    imageHeight: 360,
    fit: 'contain',
    objectPosition: 'center center',
    opacity: 1,
    z: 8
  },
  irl: {
    x: 1950,
    y: 1160,
    width: 205,
    imageHeight: 275,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 7
  },
  'sem-doc': {
    x: 1940,
    y: 130,
    width: 225,
    imageHeight: 275,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 5
  },
  'memorias-de-marte': {
    x: 1580,
    y: 220,
    width: 230,
    imageHeight: 170,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 6
  },
  'nunca-mais-do-mesmo': {
    x: 1600,
    y: 1450,
    width: 205,
    imageHeight: 265,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 5
  },
  'arquivo-pb': {
    x: 310,
    y: 1450,
    width: 165,
    imageHeight: 215,
    fit: 'cover',
    objectPosition: 'center center',
    opacity: 1,
    z: 3
  }
};

function getField(project: typeof projects[number]) {
  return fieldOverrides[project.slug] ?? project.field;
}

function getFieldImage(project: typeof projects[number]) {
  if (project.slug === 'scroll') {
    return '';
  }
  if (project.randomHero && project.gallery?.length) {
    return project.gallery[0];
  }
  return project.fieldImage ?? project.hero ?? project.gallery?.[0] ?? '';
}

function getHref(slug: string) {
  return `/projetos/${slug}`;
}
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="Campo de projetos de Lucas Stanso." />
  <title>CAMPO — STANSO</title>
  <style>
    :root {
      --bg: #eeeeea;
      --ink: #11110f;
      --muted: #777771;
      --line: rgba(17,17,15,.14);
      --grid-line: rgba(17,17,15,.055);
      --grid-size: 42px;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, Helvetica, sans-serif;
    }
    * { box-sizing: border-box; }
    html { margin: 0; padding: 0; min-width: 100%; background: var(--bg); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    body { margin: 0; padding: 0; min-width: 100%; overflow: hidden; background: var(--bg); color: var(--ink); }
    a { color: inherit; }
    img, video { display: block; }
    img { max-width: 100%; }

    .site-header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 5000; height: 64px; padding: 0 28px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(17,17,15,.09); background: rgba(238,238,234,.95);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    }
    .site-brand { color: var(--ink); text-decoration: none; font-size: 11px; font-weight: 630; }
    .site-nav { display: flex; align-items: center; gap: 25px; }
    .site-nav a { color: var(--muted); text-decoration: none; font-size: 10px; }
    .site-nav a:hover, .site-nav a[aria-current="page"] { color: var(--ink); }

    .field-viewport {
      position: fixed; inset: 64px 0 0; overflow: hidden; overscroll-behavior: none;
      touch-action: none; cursor: grab; user-select: none; background: var(--bg);
    }
    .field-viewport.is-dragging { cursor: grabbing; }

    .field-stage {
      position: absolute; top: 0; left: 0; width: 2900px; height: 2000px;
      background-color: var(--bg);
      background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
                        linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
      background-size: var(--grid-size) var(--grid-size);
      transform: translate3d(0,0,0); transform-origin: 0 0; will-change: transform;
    }

    .field-item {
      position: absolute; left: var(--x); top: var(--y); width: var(--w); z-index: var(--z); opacity: 1;
    }
    .field-card {
      position: relative; z-index: 2; display: block; width: 100%; color: var(--ink);
      text-decoration: none; transform: translate3d(0,0,0); transform-origin: center; transition: opacity .16s ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .field-card:hover { opacity: .72; }
      .field-card--feed:hover { opacity: 1; }
      .field-card--scroll:hover { opacity: .62; }
    }
    .field-media { width: 100%; height: var(--image-h); overflow: hidden; background: transparent; }
    .field-media img, .field-media video { width: 100%; height: 100%; object-fit: var(--fit); object-position: var(--object-position); pointer-events: none; }
    .field-caption { padding-top: 8px; display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
    .field-title { min-width: 0; font-size: 10px; line-height: 1; font-weight: 560; letter-spacing: -.02em; }
    .field-meta { flex: 0 0 auto; color: var(--muted); font-size: 8px; line-height: 1; }

    .field-card--scroll { width: 100%; padding: 0; opacity: 1; background: transparent; }
    .scroll-title { margin: 0; width: max-content; max-width: none; font-size: clamp(76px,7vw,132px); line-height: .73; font-weight: 580; letter-spacing: -.075em; white-space: nowrap; }
    .scroll-info { margin-top: 20px; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 35px; align-items: start; }
    .scroll-subtitle { width: 260px; color: var(--muted); font-size: 9px; line-height: 1.4; }
    .scroll-year { color: var(--muted); font-size: 8px; line-height: 1; }
    .field-card--nomofobia .field-title { font-size: 12px; }

    .field-card--feed { padding: 9px; background: #080808; color: white; }
    .feed-ad-head { min-height: 30px; padding: 0 2px 8px; display: flex; align-items: center; justify-content: space-between; gap: 15px; color: rgba(255,255,255,.67); font-size: 8px; }
    .field-card--feed .field-media { height: auto; background: white; }
    .field-card--feed .field-media img, .field-card--feed .field-media video { width: 100%; height: auto; object-fit: contain; object-position: center; }
    .feed-ad-foot { min-height: 39px; padding: 9px 2px 0; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 20px; }
    .feed-ad-title { font-size: 10px; font-weight: 600; }
    .feed-ad-cta { color: rgba(255,255,255,.68); font-size: 8px; }

    .field-fallback { width: 100%; min-height: 105px; padding: 12px; display: flex; align-items: flex-end; border: 1px solid var(--line); }
    .field-fallback span { font-size: clamp(17px,1.5vw,26px); line-height: .9; font-weight: 540; letter-spacing: -.04em; }
  </style>
</head>
<body>

  <header class="site-header">
    <a href="/campo" class="site-brand">STANSO</a>
    <nav class="site-nav" aria-label="Navegação principal">
      <a href="/campo" aria-current="page">CAMPO</a>
      <a href="/indice">ÍNDICE</a>
      <a href="/indice#sobre">CONTATO</a>
    </nav>
  </header>

  <main class="field-viewport" id="field-viewport">
    <div class="field-stage" id="field-stage" data-stage-width={STAGE_WIDTH} data-stage-height={STAGE_HEIGHT}>
      {
        orderedProjects.map((project) => {
          const field = getField(project);
          if (!field) return null;

          const image = getFieldImage(project);
          const imageHeight = field.imageHeight ?? Math.round(field.width * 1.18);
          const fit = field.fit ?? 'cover';
          const objectPosition = field.objectPosition ?? 'center center';
          const z = field.z ?? 1;
          const motion = project.motion ?? 'still';
          const zone = project.zone ?? 'archive';
          const href = getHref(project.slug);

          const style = `
            --x:${field.x}px;
            --y:${field.y}px;
            --w:${field.width}px;
            --image-h:${imageHeight}px;
            --fit:${fit};
            --object-position:${objectPosition};
            --z:${z};
          `;

          const galleryData = project.randomHero ? JSON.stringify(project.gallery) : '';

          return (
            <article
              class="field-item"
              data-slug={project.slug}
              data-motion={motion}
              data-zone={zone}
              style={style}
            >
              {project.slug === 'scroll' ? (
                <a href="/projetos/scroll" class="field-card field-card--scroll">
                  <h1 class="scroll-title">SCROLL</h1>
                  <div class="scroll-info">
                    <div class="scroll-subtitle">desejo e visualidade na cultura algorítmica</div>
                    <div class="scroll-year">2025—2026</div>
                  </div>
                </a>
              ) : project.slug === 'feed' ? (
                <a href="/projetos/feed" class="field-card field-card--feed">
                  <div class="feed-ad-head">
                    <span>PATROCINADO</span>
                    <span>FEED</span>
                  </div>
                  {image && (
                    <div class="field-media">
                      <img src={image} alt="FEED" draggable="false" loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="feed-ad-foot">
                    <span class="feed-ad-title">FEED</span>
                    <span class="feed-ad-cta">COMPRE AQUI ↗</span>
                  </div>
                </a>
              ) : (
                <a href={href} class={`field-card field-card--${project.slug}`}>
                  {image ? (
                    <div class="field-media">
                      <img
                        src={image}
                        alt={project.title}
                        draggable="false"
                        loading={project.slug === 'nomofobia' ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                  ) : (
                    <div class="field-fallback">
                      <span>{project.title}</span>
                    </div>
                  )}
                  <div class="field-caption">
                    <span class="field-title">{project.title}</span>
                    <span class="field-meta">{project.year}</span>
                  </div>
                </a>
              )}
            </article>
          );
        })
      }
    </div>
  </main>

</body>
</html>npm