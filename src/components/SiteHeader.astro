---
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['CAMPO', '/campo'],
  ['ÍNDICE', '/indice'],
];
---
<header class="site-header">
  <a class="site-brand" href={`${base}/campo`}>STANSO</a>
  <nav class="site-nav" aria-label="Navegação principal">
    {nav.map(([label, path]) => (
      <a href={`${base}${path}`} aria-current={active === label ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
